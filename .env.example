# Port for UniSphere EMS
PORT=3000

# Gemma Local Inference Endpoint (Default: Ollama)
GEMMA_ENDPOINT=http://localhost:11434/api/generate

# Gemma Open-Weight Model (gemma2:2b, gemma2:9b, gemma:7b)
GEMMA_MODEL=gemma2:2b

# Optional API Key for Remote HuggingFace or Cloud Inference
# GEMMA_API_KEY=your_key_here
